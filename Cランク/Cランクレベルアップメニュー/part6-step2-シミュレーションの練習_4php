<?php
    // 自分の得意な言語で
    // Let's チャレンジ！！
    $n = trim(fgets(STDIN));
    [$a, $b] = array_map('intval', explode(" ", trim(fgets(STDIN))));
    $paiza = $kirishima = 1;
    $count = 0;
    while ($kirishima <= $n) {
        // パイザ君は自分の番が来ると、自分のもっている数の a 倍を霧島京子の数に足してあげます。
        $kirishima += $paiza * $a;
        $count++;
        // 霧島京子は自分の番が来ると、自分のもっている数を b で割った余りをパイザ君の数に足してあげます。
        $paiza += $kirishima % $b;
    }
    echo "$count\n";
?>